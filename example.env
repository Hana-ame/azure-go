# Moonchan Upload Server 配置示例
# 复制此文件为 .env 并按需修改

# ========== Azure / OneDrive (旧后端, 仅 legacy) ==========
# AZURE_DISABLE=true 时以下全部可留空
tenent_id=
client_id=
redirect_url=
scope=https://graph.microsoft.com/.default
user_id=
# 客户端密钥写入 client_secrets.txt (纯文本, 末尾无换行), 不在 .env 中

# ========== Cloudflare R2 (默认上传后端) ==========
# R2_ACCOUNT_ID 是 Cloudflare 账户 ID (dashboard 首页右侧可找到)
R2_ACCOUNT_ID=
# R2 的 Access Key (需在 R2 页面手动创建)
R2_ACCESS_KEY_ID=
# R2 的 Secret Key
R2_SECRET_ACCESS_KEY=
# 存储桶名称 (需先在 R2 创建好)
R2_BUCKET_NAME=
# R2 自定义域名或公共访问 URL (最终公开访问的地址)
R2_PUBLIC_URL=

# ========== 本地文件系统后端 (?dest=local) ==========
# 文件存储目录, 默认当前目录
LOCAL_STORAGE_PATH=
# 本地文件公开访问前缀, 留空则自动从请求 Host 推断
LOCAL_PUBLIC_URL=

# ========== 服务 ==========
# 监听地址, 默认 :8080
LISTEN_ADDR=:8080
# 是否禁用 Azure OneDrive, true=禁用(仅用 R2 和本地)
AZURE_DISABLE=true
# 删除验证用盐值, 随意设一个随机字符串
SALT=

# ========== API 使用示例 ==========
#
# 上传 (PUT raw body):
#   curl -X PUT 'https://upload.moonchan.xyz/api/upload' \
#     -H 'Content-Type: image/jpeg' --data-binary @photo.jpg
#
# 上传 (POST multipart, 前端友好):
#   curl -X POST 'https://upload.moonchan.xyz/api/upload' \
#     -F 'file=@photo.jpg'
#
# 上传到本地文件系统:
#   curl -X PUT 'https://upload.moonchan.xyz/api/upload?dest=local' \
#     -H 'Content-Type: image/jpeg' --data-binary @photo.jpg
#
# 访问文件:
#   # 本地存储
#   curl https://upload.moonchan.xyz/local/1700000000/abc123.jpg
#   # R2 文件 (通过 CDN)
#   curl https://r2.moonchan.xyz/1700000000/abc123.jpg
#
# 删除文件 (使用返回的 delete_url):
#   curl -X GET 'https://upload.moonchan.xyz/local/1700000000/abc123.jpg?delete=<hash>'
#
# 响应格式:
#   {"id":"<sha256>","path":"/<ts>/<fn>","url":"https://...","delete_url":"https://...?delete=<hash>"}
#   url=可公开访问, delete_url=访问即删除(需 hash 验证)
#
# 前端页面:
#   http://localhost:8080/  (localhost 自动使用本地存储)
#   http://localhost:8080/?dest=local  (显式指定本地存储)
